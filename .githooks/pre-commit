#!/bin/bash
# Refuses a commit whose tests do not pass. See CONTRIBUTING.md.
#
# This exists because the project has repeatedly shipped regressions inside
# fixes for other bugs. Skipping it is a deliberate act:  git commit --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# A GUI-launched shell has almost no PATH, and so does a git hook invoked from
# some editors — swiftc and mac-ocr both go missing and the run reports nonsense.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

touches_sources=$(echo "$staged" | grep -c '^Sources/' || true)
touches_tests=$(echo "$staged"   | grep -c '^Tests/'   || true)
touches_bugs=$(echo "$staged"    | grep -c '^BUGS.md$' || true)

if [ "$touches_sources" -gt 0 ] && [ "$touches_tests" -eq 0 ] && [ "$touches_bugs" -eq 0 ]; then
  echo "note: Sources/ changed with no test and no BUGS.md entry."
  echo "      A fix without a test that fails without it is not finished — see CONTRIBUTING.md."
  echo "      Continuing; this is a warning, not a refusal."
fi

# Docs-only commits do not need forty minutes of real OCR. Anything that can
# change behaviour does: sources, tests, the build or test scripts, the tools.
# Helper/ is in the list because R40 put shipped code there: it builds
# visionocr-recognise, which does the recognition for every batch. A change to
# it that skipped the suite would skip the parity check that is the only thing
# holding the helper and the app to the same observations.
if ! echo "$staged" | grep -qE '^(Sources/|Helper/|Tests/|Tools/|build\.sh|run_tests\.sh)'; then
  echo "pre-commit: no code staged, skipping the suite."
  exit 0
fi

if ! command -v swiftc >/dev/null 2>&1; then
  echo "pre-commit: swiftc not on PATH, cannot verify. Refusing." >&2
  exit 1
fi

# A staged tool gets type-checked, because until C25 nothing checked that a tool
# compiled at all: score-text-route had never built in any commit, and the
# annotation commit silently broke score-skew and score-reading-order eleven days
# later by adding a field to a struct they transcribed by hand. Only the staged
# ones, which is seconds rather than the two minutes the whole of Tools/ costs.
# Existing files only: a staged *deletion* is still a staged path, and passing one
# would make the checker refuse a commit whose whole content is removing a tool.
#
# `sh` is in the pattern from 2026-08-27 (BUGS.md T20). T16 added `bash -n` over
# Tools/*.sh to check-tools-compile.sh and left this selector at swift|py, so the
# shell arm had never run at commit time in the twelve days since. Measured
# through this hook with a syntactically broken Tools/vm-gui-check.sh staged
# ALONE: no "type-checking the staged tools" line was printed at all, the whole
# suite ran (1355/1355, ~5 min of real OCR), and the commit was ALLOWED — the one
# check relevant to the only staged file being the one skipped. With `sh` here
# the same staged set reads `0 Swift, 0 Python, 1 shell` and refuses in about a
# second. It is the cheapest arm there is, and it now covers
# check-tools-compile.sh itself.
#
# ⚠️ Two things it still does NOT reach, both measured, both the queue's
# `hook-selfcheck`: a commit staging only .githooks/pre-commit exits at "no code
# staged" above, before this block; and the sweep behind it globs Tools/ and
# .githooks/ only, so run_tests.sh, ops/autonomous/test-lock.sh and build.sh --
# all three run BY this hook, all three able to refuse a commit -- are unchecked.
staged_tools=""
while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$f" ] && staged_tools="$staged_tools $f"
done <<EOF
$(echo "$staged" | grep -E '^Tools/.*\.(swift|py|sh)$' || true)
EOF
if [ -n "${staged_tools// /}" ]; then
  echo "pre-commit: type-checking the staged tools…"
  # shellcheck disable=SC2086
  if ! ./Tools/check-tools-compile.sh $staged_tools; then
    echo "pre-commit: a staged tool does not build — commit refused." >&2
    exit 1
  fi
fi

# A staged Python tool that can test itself, does. `py_compile` was the entire
# gate for Tools/*.py, and a parser that accepts a malformed row compiles
# perfectly — which is how a consumer's `len(f) >= 9` survived two separate
# field-count defects (T14, A12.3). Advertise one the way sample-zotero.py does,
# with an argparse flag; these run against fakes rather than the corpus, so the
# cost is a second or two. The Swift tools' --self-test stays out of the hook on
# purpose: each one needs a 25-second build first.
while IFS= read -r f; do
  { [ -n "$f" ] && [ -f "$f" ]; } || continue
  # Quote-agnostic: `add_argument('--self-test'` is the same capability, and the
  # first version's double-quoted literal skipped it *silently* — which is the
  # default check-tools-compile.sh argues against three files away.
  grep -qE "add_argument\(.--self-test." "$f" || continue
  echo "pre-commit: $f --self-test…"
  if ! python3 "$f" --self-test; then
    echo "pre-commit: $f --self-test FAILED — commit refused." >&2
    exit 1
  fi
done <<EOF
$(echo "$staged" | grep -E '^Tools/.*\.py$' || true)
EOF

# ⚠️ SAY THE REAL NUMBER. This read "2-4 minutes" until 2026-08-16, when the suite was timed end to end:
# **39m30s** (lock acquired 20:29:23, released 21:08:53, 1137/1137 with no skips) — swiftc 1m47s of it, the
# `tests` binary the other 37m43s, single-core bound at ~96% CPU throughout. The health gate that wraps it
# measured 44m53s the same evening. Understating it is not a cosmetic slip: an unattended session budgeted
# four minutes for its commit, backgrounded it, ended its turn while this hook was still running, and killed
# the commit — 95 minutes of finished, green work never landed. A caller who knows it is forty minutes waits.
# ✅ AND SAYING THE REAL NUMBER MEANS CHANGING IT AGAIN, 2026-08-24: it is now ~4 MINUTES. Everything above
# was measured while the daemon's launchd plist set ProcessType=Background — darwin-bg, E-cores, inherited by
# every child including this hook — and while run_tests.sh passed no -O. Together 16.2x. A real hook run
# measured 236 s afterwards. The 2026-08-16 lesson is unchanged and is why this line is still printed at all:
# understating it killed a commit. Overstating it by 10x has the mirror cost — a caller who budgets forty
# minutes for a four-minute hook waits idle, or worse, concludes it is wedged. See the ProcessType comment in
# ops/autonomous/com.visionocr.autonomous.plist.
echo "pre-commit: running ./run_tests.sh (~4 minutes on this machine; it runs real OCR)…"
log=$(mktemp -t vrg-precommit)
# ONE SUITE AT A TIME, machine-wide. `build/tests` has no bundle identifier, so
# UserDefaults.standard lands in ~/Library/Preferences/tests.plist keyed by the
# process *name* — and every worktree shares that one file. A second suite's
# resetPrefs() wipes this one's settings mid-run: measured 882/883 -> 877/879,
# with two failures in the run-report block that had nothing to do with the
# change under test. CLAUDE.md lists it first among the environment traps.
#
# Until the autonomous daemon existed this was a discipline — one human, one
# suite at a time, and remembering. A daemon that commits on its own cadence
# turns it into a race: its health gate runs the suite, and every session's
# commit lands here. So the hook takes the lock rather than trusting whoever is
# at the keyboard. That protects interactive commits too, which is the point:
# the collision needs only ONE careless party, and now neither party can be one.
#
# ⚠️ DEGRADES EXACTLY TO THE OLD BEHAVIOUR when the helper is absent (an older
# checkout, a clone that has not merged ops/autonomous yet). This guard must
# never be the reason a commit cannot happen — it is here to make evidence
# trustworthy, not to add a way to fail.
#
# The lock is acquired here and released by an EXIT trap rather than wrapping
# the suite in `test-lock.sh run`, so its "waiting for the suite" notice reaches
# your terminal instead of being swallowed into $log — a hook that appears to
# hang for ten minutes with no explanation is worse than one that says why.
LOCK_SH="ops/autonomous/test-lock.sh"
if [ -x "$LOCK_SH" ]; then
  # VISIONOCR_TEST_LOCK_PID makes THIS hook the holder of record, so if the
  # commit is interrupted the lock is reclaimable the moment this pid is gone.
  # ⚠️ THE WAIT MUST EXCEED ONE SUITE. 3600 now exceeds it by ~15x (236 s measured 2026-08-24), and is
  # deliberately NOT reduced: waiting is cheaper than breaking a lock, and a queue behind a mutation
  # campaign is still long. This was `--wait 1800` against a suite measured at 39m30s, so the
  # hook gave up NINE MINUTES BEFORE a healthy run could possibly have finished — and then blamed the run
  # it was queued behind, in a message asserting the lock "never freed". Written out here rather than left
  # to test-lock.sh's default so the number sits next to the sentence that quotes it.
  hook_wait="${VISIONOCR_PRECOMMIT_LOCK_WAIT:-3600}"
  # Coerce a junk override rather than letting `$((hook_wait / 60))` fault inside the error path — the one
  # place that must still be able to print why it refused.
  case "$hook_wait" in ''|*[!0-9]*) hook_wait=3600 ;; esac
  if ! VISIONOCR_TEST_LOCK_PID=$$ "$LOCK_SH" acquire --label "pre-commit $$" --wait "$hook_wait"; then
    echo >&2
    echo "pre-commit: another test suite has held the lock for $((hook_wait / 60)) minutes — longer than the" >&2
    echo "            ~4 min a healthy suite takes, so it is stuck rather than merely slow. Refusing" >&2
    echo "            rather than running a second suite, which would corrupt BOTH runs' results." >&2
    echo "            Check who holds it:  $LOCK_SH status" >&2
    exit 1
  fi
  trap 'VISIONOCR_TEST_LOCK_PID=$$ "$LOCK_SH" release >/dev/null 2>&1' EXIT
fi

# Timed so this run reaches $STATE/suite-timings.tsv like every other. The hook holds the lock with
# acquire/trap-release rather than `test-lock.sh run` (so the "waiting for the suite" notice reaches your
# terminal instead of $log), which means it does NOT get `run`'s automatic timing — and the hook is the most
# frequent suite runner there is, so a ledger without it would under-report the common case. `record` keeps
# the row format in test-lock.sh, the one place that owns it.
suite_t0=$(date +%s)
./run_tests.sh >"$log" 2>&1; suite_rc=$?
[ -x "$LOCK_SH" ] && "$LOCK_SH" record --label "pre-commit $$" \
  --seconds "$(( $(date +%s) - suite_t0 ))" --rc "$suite_rc" 2>/dev/null || true
if [ "$suite_rc" -ne 0 ]; then
  echo >&2
  echo "pre-commit: TESTS FAILED — commit refused." >&2
  echo >&2
  grep -E 'FAIL|error:' "$log" | head -20 >&2
  echo >&2
  echo "full output: $log" >&2
  exit 1
fi
tail -2 "$log" | tr -d '\n'; echo
rm -f "$log"

# The suite compiles the views but never instantiates one, so a UI change needs
# the real build too.
if echo "$staged" | grep -qE '^Sources/(App|ContentView|SettingsView)\.swift$'; then
  echo "pre-commit: UI changed, building the app…"
  if ! ./build.sh >/dev/null 2>&1; then
    echo "pre-commit: ./build.sh FAILED — commit refused." >&2
    exit 1
  fi
  echo "pre-commit: app builds."
fi
