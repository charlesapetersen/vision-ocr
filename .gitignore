# Build products
build/

# Test corpus: 302 MB of copyrighted PDFs (books, journal articles, newspapers)
# sampled from a personal Zotero library. Deliberately NOT committed — it is
# third-party material and has no business in a public repository. The manifest
# is committed, so the corpus can be reassembled from a Zotero library with
# tools/sample-zotero.py.
testdocs/*
!testdocs/README.md
!testdocs/manifest.tsv
!testdocs/manifest-*.tsv

.DS_Store
*.swp
Tools/mutation-out/

# jbig2 writes output.NNNN/output.sym into the working directory
output.[0-9]*
output.sym

# Python bytecode from the tools
__pycache__/
*.pyc
