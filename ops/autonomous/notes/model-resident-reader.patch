+// model-resident-reader. A stand-in for `read-model.py --serve`, run by a stand-in runtime python as
+// `--fake-reader-server <record> -I <script> --serve <socket> --slot <lock> --idle S <model>`: the same pid
+// file, socket and answers. Each start appends `start <pid>` to `<record>.starts`; each request writes its
+// server's arguments, `--`, the request's and the model environment to `<record>`, and the words to its out
+// file. `<record>.slow` makes it sleep 60 s before answering, `<record>.hog` hold 300 MB first.
+if CommandLine.arguments.count >= 3, CommandLine.arguments[1] == "--fake-reader-server" {
+    let record = CommandLine.arguments[2]
+    let args = Array(CommandLine.arguments.dropFirst(3))
+    guard let at = args.firstIndex(of: "--serve"), at + 1 < args.count else { exit(64) }
+    let path = args[at + 1]
+    let pid = open(path + ".pid", O_RDWR | O_CREAT, 0o600)
+    guard pid >= 0, flock(pid, LOCK_EX | LOCK_NB) == 0 else { exit(1) }
+    ftruncate(pid, 0)
+    _ = "\(getpid())\n".withCString { write(pid, $0, strlen($0)) }
+    if let h = FileHandle(forWritingAtPath: record + ".starts") ?? {
+        FileManager.default.createFile(atPath: record + ".starts", contents: nil)
+        return FileHandle(forWritingAtPath: record + ".starts")
+    }() {
+        h.seekToEndOfFile(); h.write(Data("start \(getpid())\n".utf8)); h.closeFile()
+    }
+    unlink(path)
+    let listener = socket(AF_UNIX, SOCK_STREAM, 0)
+    var address = sockaddr_un()
+    address.sun_family = sa_family_t(AF_UNIX)
+    withUnsafeMutableBytes(of: &address.sun_path) { raw in
+        let bytes = Array(path.utf8)
+        raw.copyBytes(from: bytes); raw[bytes.count] = 0
+    }
+    let bound = withUnsafePointer(to: &address) {
+        $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { bind(listener, $0, socklen_t(MemoryLayout<sockaddr_un>.size)) }
+    }
+    guard bound == 0, listen(listener, 4) == 0 else { exit(1) }
+    var hog: [UInt8] = []
+    var idleSince = Date()
+    while true {
+        var p = pollfd(fd: listener, events: Int16(POLLIN), revents: 0)
+        if poll(&p, 1, 200) <= 0 {
+            // The suite does not wait out a minute's idle: 20 s, then gone once the slot is free.
+            guard Date().timeIntervalSince(idleSince) > 20 else { continue }
+            let at = args.firstIndex(of: "--slot").map { args[$0 + 1] } ?? ""
+            let slot = open(at, O_RDWR | O_CREAT, 0o600)
+            if slot >= 0, flock(slot, LOCK_EX | LOCK_NB) == 0 {
