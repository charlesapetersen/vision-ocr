+        var line = Data(), byte: UInt8 = 0
+        while read(conn, &byte, 1) == 1, byte != UInt8(ascii: "\n") { line.append(byte) }
+        let argv = ((try? JSONSerialization.jsonObject(with: line)) as? [String: [String]])?["argv"] ?? []
+        let env = ProcessInfo.processInfo.environment
+        try? (args + ["--"] + argv + ["HF_HOME=\(env["HF_HOME"] ?? "")", "OFFLINE=\(env["HF_HUB_OFFLINE"] ?? "")"])
+            .joined(separator: "\n").write(toFile: record, atomically: true, encoding: .utf8)
